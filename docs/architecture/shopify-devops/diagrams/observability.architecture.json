  "cards": [
    {
      "dot": "cyan",
      "title": "Nhãn có giới hạn",
      "items": [
        "Metric theo route template, không bao giờ theo id",
        "Log JSON mang requestId, traceId, spanId; Alloy chỉ gắn nhãn namespace, cell, app",
        "Grafana mở trace từ traceId của log, và log từ span",
        "Series theo shop mang tenant_id; mọi series có nhãn cell; dashboard lưu trong Git"
      ]
    },
    {
      "dot": "amber",
      "title": "Rule alert trong Git",
      "items": [
        "ShopServerErrorRatioHigh và ShopOldestPendingOrderStale (shop-alerts)",
        "PromotionHalted và SyntheticCheckoutFailing (promoter)",
        "PlusTenantCheckoutBudgetBurnFast và Slow (tenant-slo, chỉ shop plus)",
        "Rule mặc định của chart bị tắt (defaultRules.create=false)"
      ]
    }
  ]
