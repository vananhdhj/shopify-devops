      "variant": "return"
    },
    {
      "id": "load",
      "from": "worker",
      "to": "pg",
      "y": 275,
      "label": "④ tenant tx: SELECT status, scenario, items"
    },
    {
      "id": "deduct",
      "from": "worker",
      "to": "catalog",
      "y": 310,
      "label": "⑤ POST deduct · tenantId trong body · x-internal-token",
