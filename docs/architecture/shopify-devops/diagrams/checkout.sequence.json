    },
    {
      "id": "tx-ok",
      "from": "pg",
      "to": "orders",
      "y": 369,
      "label": "ok, hoặc 23505 unique",
      "variant": "return"
    },
    {
      "id": "accepted",
      "from": "orders",
      "to": "client",
      "y": 405,
      "label": "⑤ 202 orderId + orderToken (HMAC)",
