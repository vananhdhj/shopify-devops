{
  "uid": "tenant",
  "title": "Tenant",
  "description": "One shop: its requests and the limits it hits, its Checkout latency and outcomes, its Orders, and its plan's quota (Phase 5).",
  "tags": [
    "shop",
    "phase-5"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": false,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "current": {}
      },
      {
        "name": "tenant",
        "type": "query",
        "label": "Shop",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(tenant_info{internal=\"false\"}, tenant)",
          "refId": "tenant"
        },
        "refresh": 2,
        "hide": 0,
        "current": {}
      },
      {
        "name": "tenant_id",
        "type": "query",
        "label": "Shop id",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(tenant_info{tenant=\"$tenant\"}, tenant_id)",
          "refId": "tenant_id"
        },
        "refresh": 2,
        "hide": 2,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Requests",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests through the edge, by status class",
      "description": "Everything the shop's buyers asked for, as the edge answered it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (code_class) (rate(router_requests_total[2m]) * on (tenant_id) group_left (tenant) max by (tenant_id, tenant) (tenant_info{tenant=\"$tenant\"}))",
          "legendFormat": "{{code_class}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Refused by the rate quota",
      "description": "Requests over the plan's rate, answered 429 by the edge.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(router_rate_limited_total[2m]) * on (tenant_id) group_left (tenant) max by (tenant_id, tenant) (tenant_info{tenant=\"$tenant\"}))",
          "legendFormat": "429 rate quota"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Edge latency",
      "description": "Time the edge took to answer, the cell included.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(router_request_duration_seconds_bucket[5m]) * on (tenant_id) group_left (tenant) max by (tenant_id, tenant) (tenant_info{tenant=\"$tenant\"})))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(router_request_duration_seconds_bucket[5m]) * on (tenant_id) group_left (tenant) max by (tenant_id, tenant) (tenant_info{tenant=\"$tenant\"})))",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "Checkout and Orders",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Checkout latency",
      "description": "The order service's Checkout, accepted ones.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(checkout_duration_seconds_bucket{outcome=\"accepted\"}[5m]) * on (tenant_id) group_left (tenant) max by (tenant_id, tenant) (tenant_info{tenant=\"$tenant\"})))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Checkouts, by outcome",
      "description": "accepted, refused, busy (the plan's cap), unavailable, error.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (outcome) (rate(checkout_duration_seconds_count[5m]) * on (tenant_id) group_left (tenant) max by (tenant_id, tenant) (tenant_info{tenant=\"$tenant\"})) * 60",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Orders settled per minute, by outcome",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (outcome) (rate(orders_settled_total[5m]) * on (tenant_id) group_left (tenant) max by (tenant_id, tenant) (tenant_info{tenant=\"$tenant\"})) * 60",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Oldest Pending order",
      "description": "This shop's oldest Order still Pending.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(orders_oldest_pending_age_seconds * on (tenant_id) group_left (tenant) max by (tenant_id, tenant) (tenant_info{tenant=\"$tenant\"}))",
          "legendFormat": "Oldest Pending"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Plan",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "table",
      "title": "Plan and cell",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "tenant_info{tenant=\"$tenant\"}",
          "legendFormat": "",
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 12,
      "type": "logs",
      "title": "Warnings and errors (logs, last 24 h at most)",
      "description": "The shop's warning and error lines from every unit and cell, by its tenant id (the APIs) or handle (the edge and the storefront). Loki keeps 24 h.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{namespace=~\"shop-dev|cell-.+|edge-dev|platform-dev\"} | json | tenantId = \"$tenant_id\" or tenant = \"$tenant\" | severity =~ \"warn|error\""
        }
      ]
    }
  ]
}
