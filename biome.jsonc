{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": [
			"**",
			"!**/.next",
			"!**/dist",
			"!**/next-env.d.ts",
			"!docs/architecture"
		]
	},
	// Lint only; formatting is left to editors for now.
	"formatter": { "enabled": false },
	"assist": { "enabled": false },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				// tsconfig enables noUncheckedIndexedAccess, so `rows[0]!` after a check is the
				// deliberate idiom here; the assertion is the reviewed exception, not an accident.
				"noNonNullAssertion": "off"
			}
		}
	}
}
