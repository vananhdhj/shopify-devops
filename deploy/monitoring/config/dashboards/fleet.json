{
  "uid": "fleet",
  "title": "Fleet",
  "description": "Every cell at once: its shops, its traffic and errors through the edge, its synthetic Checkout, and the releases moving through the waves (Phase 5).",
  "tags": [
    "shop",
    "phase-5"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": false,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Cells",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "table",
      "title": "Shops per cell",
      "description": "Shops that are not deleted, by cell (synthetic shops excluded).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count by (cell) (max by (tenant_id, cell) (tenant_info{internal=\"false\"}))",
          "legendFormat": "",
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Synthetic Checkout, by cell",
      "description": "Seconds for each cell's synthetic shop's Checkout to settle; gaps or failures mean its buyers likely cannot check out.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (cell, le) (rate(synthetic_checkout_seconds_bucket[10m])))",
          "legendFormat": "{{cell}} p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Synthetic failures in a row",
      "description": "SyntheticCheckoutFailing fires at 2.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (cell) (synthetic_checkout_consecutive_failures)",
          "legendFormat": "{{cell}}"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests per second through the edge, by cell",
      "description": "Every shop's requests, by the cell that served them.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cell) (rate(router_requests_total{cell!=\"\"}[2m]))",
          "legendFormat": "{{cell}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "5xx share at the edge, by cell",
      "description": "Server errors among the requests the edge answered for each cell.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cell) (rate(router_requests_total{cell!=\"\",code_class=\"5xx\"}[5m])) / sum by (cell) (rate(router_requests_total{cell!=\"\"}[5m]))",
          "legendFormat": "{{cell}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Refused by a quota, by cell",
      "description": "429s: the edge's rate quota and the order service's Checkout cap.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cell) (rate(router_rate_limited_total{cell!=\"\"}[5m]))",
          "legendFormat": "{{cell}} rate quota"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cell) (rate(checkouts_busy_total[5m]))",
          "legendFormat": "{{cell}} Checkout busy"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Oldest Pending order, by cell",
      "description": "ShopOldestPendingOrderStale fires above 60 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (cell) (orders_oldest_pending_age_seconds)",
          "legendFormat": "{{cell}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "Waves",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Soaking",
      "description": "1 while a wave's release is soaking before promotion.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (wave) (promotion_soaking)",
          "legendFormat": "wave {{wave}}"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Halted",
      "description": "1 while a wave's release failed its gate (PromotionHalted); it clears when the wave moves on.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 26,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (wave) (promotion_halted)",
          "legendFormat": "wave {{wave}}"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Gate checks failing",
      "description": "Failed gate checks of soaking releases, by wave and check.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 26,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (wave, check) (increase(promotion_gate_checks_total{outcome=\"fail\"}[10m]))",
          "legendFormat": "wave {{wave}} {{check}}"
        }
      ]
    }
  ]
}
